# Public URL of this instance (used to build the GitLab webhook URL)
SQUAD_PUBLIC_URL=https://squad.example.com
# Encrypts tokens stored in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SQUAD_SECRET_KEY=
# Protects the admin UI and API with HTTP basic auth
SQUAD_ADMIN_USER=admin
SQUAD_ADMIN_PASSWORD=change-me
# Default: SQLite file. For PostgreSQL:
# SQUAD_DATABASE_URL=postgresql+psycopg://squad:squad@postgres:5432/squad_assistant
SQUAD_DEFAULT_LANGUAGE=en
